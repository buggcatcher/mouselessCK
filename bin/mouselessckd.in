#!/usr/bin/python3 -I
# mouselessCK system daemon (installed launcher)
# `python3 -I` (isolated mode) ignores PYTHONPATH, PYTHONHOME, the user's
# site-packages and the current directory, so nobody can slip a module in
# through the environment. Code is loaded only from the root-owned path below.
import sys

sys.path.insert(0, "@PYLIBDIR@")
from mouselessck.daemon import main  # noqa: E402

sys.exit(main())
